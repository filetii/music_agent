# Which LLM backend to use: "anthropic" or "ollama"
LLM_PROVIDER=anthropic

# Anthropic (paid API) — create a key at https://platform.claude.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Ollama (free, local) — install from https://ollama.com and run: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192

# Simulated "today" for order/return reasoning (see README: Reference date)
REFERENCE_DATE=2026-03-25

# Safety cap on LLM <-> tool round trips per customer message
MAX_TOOL_STEPS=6
